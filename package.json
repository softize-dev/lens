{
  "name": "@softize/lens",
  "version": "0.7.0",
  "type": "module",
  "description": "Lente de desenvolvimento para projetos Opus: o que uma requisição fez e o que o projeto declara.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softize-dev/lens.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./kysely": "./src/kysely.ts",
    "./ui": "./src/ui/index.ts",
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "release": "bash ./scripts/release.sh"
  },
  "peerDependencies": {
    "@softize/opus": "^18.0.1 || ^19.0.0",
    "@tanstack/react-query": "^5.0.0",
    "kysely": ">=0.27.0 <0.30.0",
    "lucide-react": ">=0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.0.0",
    "@softize/opus": "18.0.1",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.11.1",
    "kysely": "^0.27.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "zod": "^3.24.0"
  },
  "packageManager": "pnpm@11.4.0"
}
